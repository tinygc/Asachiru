<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_gradient_middle"
    android:padding="32dp">

    <!-- タイトル -->
    <TextView
        android:id="@+id/title_text_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="⚙️ 初回設定"
        android:textColor="@color/text_primary"
        android:textSize="20sp"
        android:textStyle="bold"
        android:letterSpacing="0.05"
        android:shadowColor="@color/text_soft_shadow"
        android:shadowDx="2"
        android:shadowDy="2"
        android:shadowRadius="4"
        android:layout_marginBottom="20dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- 郵便番号 -->
    <TextView
        android:id="@+id/postal_code_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="📮 郵便番号（7桁）"
        android:textColor="@color/text_primary"
        android:textSize="14sp"
        android:textStyle="bold"
        android:letterSpacing="0.03"
        android:shadowColor="@color/text_soft_shadow"
        android:shadowDx="1"
        android:shadowDy="1"
        android:shadowRadius="2"
        android:layout_marginTop="14dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/title_text_view" />

    <TextView
        android:id="@+id/postal_code_description"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="※ 天気予報の地域設定に使用します"
        android:textColor="@color/pastel_peach"
        android:textSize="12sp"
        android:textStyle="italic"
        android:letterSpacing="0.02"
        android:shadowColor="@color/text_soft_shadow"
        android:shadowDx="1"
        android:shadowDy="1"
        android:shadowRadius="2"
        android:layout_marginTop="4dp"
        android:layout_marginStart="4dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/postal_code_label" />

    <TextView
        android:id="@+id/data_source_credits"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="📊 天気データ: 気象庁 (tsukumijima.net API経由)"
        android:textColor="@color/pastel_lavender"
        android:textSize="10sp"
        android:letterSpacing="0.01"
        android:gravity="start"
        android:shadowColor="@color/text_soft_shadow"
        android:shadowDx="1"
        android:shadowDy="1"
        android:shadowRadius="2"
        android:layout_marginTop="2dp"
        android:layout_marginStart="4dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/postal_code_description" />

    <EditText
        android:id="@+id/postal_code_edit_text"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:background="@drawable/input_bg_selector"
        android:elevation="4dp"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:gravity="center"
        android:hint="例: 1000001"
        android:inputType="phone"
        android:imeOptions="actionDone"
        android:maxLength="7"
        android:padding="12dp"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_secondary"
        android:textSize="14sp"
        android:layout_marginTop="6dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/data_source_credits" />

    <!-- RSS配信元（フル幅） -->
    <TextView
        android:id="@+id/rss_preset_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="📰 RSS配信元"
        android:textColor="@color/text_primary"
        android:textSize="14sp"
        android:textStyle="bold"
        android:letterSpacing="0.03"
        android:shadowColor="@color/text_soft_shadow"
        android:shadowDx="1"
        android:shadowDy="1"
        android:shadowRadius="2"
        android:layout_marginTop="24dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/postal_code_edit_text" />

    <Spinner
        android:id="@+id/rss_preset_spinner"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:background="@drawable/input_bg_selector"
        android:elevation="4dp"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:padding="12dp"
        android:popupBackground="@color/card_bg_semi"
        android:layout_marginTop="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/rss_preset_label" />

    <EditText
        android:id="@+id/rss_custom_url_edit_text"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:background="@drawable/input_bg_selector"
        android:elevation="4dp"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:gravity="center_vertical"
        android:hint="🔗 カスタムURL入力"
        android:inputType="textUri"
        android:imeOptions="actionDone"
        android:padding="12dp"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_secondary"
        android:textSize="14sp"
        android:visibility="gone"
        android:layout_marginTop="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/rss_preset_spinner" />

    <!-- TTS設定 -->
    <CheckBox
        android:id="@+id/enable_tts_checkbox"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🔊 読み上げ機能を有効にする"
        android:textColor="@color/text_primary"
        android:textSize="14sp"
        android:textStyle="bold"
        android:letterSpacing="0.02"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:background="@drawable/checkbox_focus_bg"
        android:padding="12dp"
        android:checked="false"
        android:layout_marginTop="14dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/rss_custom_url_edit_text" />

    <!-- BGM設定 -->
    <CheckBox
        android:id="@+id/enable_bgm_checkbox"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🎵 BGMを有効にする"
        android:textColor="@color/text_primary"
        android:textSize="14sp"
        android:textStyle="bold"
        android:letterSpacing="0.02"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:background="@drawable/checkbox_focus_bg"
        android:padding="12dp"
        android:checked="true"
        android:layout_marginTop="8dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/enable_tts_checkbox" />

    <TextView
        android:id="@+id/tts_copyright_notice"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="⚠️ 著作権は各コンテンツ提供者に帰属します"
        android:textColor="@color/pastel_peach"
        android:textSize="11sp"
        android:textStyle="italic"
        android:letterSpacing="0.01"
        android:gravity="start"
        android:shadowColor="@color/text_soft_shadow"
        android:shadowDx="1"
        android:shadowDy="1"
        android:shadowRadius="2"
        android:layout_marginTop="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/enable_bgm_checkbox" />

    <!-- 保存ボタン -->
    <Button
        android:id="@+id/save_button"
        android:layout_width="300dp"
        android:layout_height="60dp"
        android:background="@drawable/rounded_button_bg"
        android:elevation="6dp"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:text="💾 保存して開始"
        android:textColor="@color/text_white"
        android:textSize="16sp"
        android:textStyle="bold"
        android:letterSpacing="0.05"
        android:stateListAnimator="@null"
        android:layout_marginTop="20dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tts_copyright_notice" />

    </androidx.constraintlayout.widget.ConstraintLayout>
