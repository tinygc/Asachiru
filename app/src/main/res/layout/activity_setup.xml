<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:padding="32dp">

    <!-- タイトル -->
    <TextView
        android:id="@+id/title_text_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="初回設定"
        android:textColor="#FFFFFF"
        android:textSize="36sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- 左カラム: 郵便番号 -->
    <TextView
        android:id="@+id/postal_code_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="郵便番号（7桁）"
        android:textColor="#FFFFFF"
        android:textSize="22sp"
        android:layout_marginTop="12dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/title_text_view" />

    <EditText
        android:id="@+id/postal_code_edit_text"
        android:layout_width="320dp"
        android:layout_height="48dp"
        android:background="#333333"
        android:gravity="center"
        android:hint="例: 1000001"
        android:inputType="number"
        android:maxLength="7"
        android:textColor="#FFFFFF"
        android:textColorHint="#888888"
        android:textSize="22sp"
        android:layout_marginTop="6dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/postal_code_label" />

    <!-- 右カラム: ニュース間隔 -->
    <TextView
        android:id="@+id/news_interval_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="ニュース間隔"
        android:textColor="#FFFFFF"
        android:textSize="22sp"
        android:layout_marginTop="12dp"
        android:layout_marginStart="24dp"
        app:layout_constraintStart_toEndOf="@id/postal_code_label"
        app:layout_constraintTop_toBottomOf="@id/title_text_view" />

    <TextView
        android:id="@+id/news_interval_text_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="30 分"
        android:textColor="#FFFFFF"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_marginTop="6dp"
        android:layout_marginStart="24dp"
        app:layout_constraintStart_toEndOf="@id/postal_code_edit_text"
        app:layout_constraintTop_toBottomOf="@id/news_interval_label" />

    <SeekBar
        android:id="@+id/news_interval_seek_bar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:max="60"
        android:min="1"
        android:progress="30"
        android:layout_marginTop="6dp"
        android:layout_marginStart="24dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/postal_code_edit_text"
        app:layout_constraintTop_toBottomOf="@id/news_interval_text_view" />

    <!-- RSS配信元（フル幅） -->
    <TextView
        android:id="@+id/rss_preset_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="RSS配信元"
        android:textColor="#FFFFFF"
        android:textSize="22sp"
        android:layout_marginTop="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/postal_code_edit_text" />

    <Spinner
        android:id="@+id/rss_preset_spinner"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:background="#333333"
        android:padding="8dp"
        android:popupBackground="#333333"
        android:layout_marginTop="6dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/rss_preset_label" />

    <EditText
        android:id="@+id/rss_custom_url_edit_text"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:background="#333333"
        android:gravity="center_vertical"
        android:hint="カスタムURL入力"
        android:inputType="textUri"
        android:padding="8dp"
        android:textColor="#FFFFFF"
        android:textColorHint="#888888"
        android:textSize="20sp"
        android:visibility="gone"
        android:layout_marginTop="6dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/rss_preset_spinner" />

    <!-- TTS設定 -->
    <CheckBox
        android:id="@+id/enable_tts_checkbox"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="読み上げ機能を有効にする"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        android:checked="false"
        android:layout_marginTop="12dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/rss_custom_url_edit_text" />

    <TextView
        android:id="@+id/tts_copyright_notice"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="※著作権は各コンテンツ提供者に帰属します"
        android:textColor="#FFCC00"
        android:textSize="16sp"
        android:gravity="start"
        android:layout_marginTop="6dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/enable_tts_checkbox" />

    <!-- 保存ボタン -->
    <Button
        android:id="@+id/save_button"
        android:layout_width="280dp"
        android:layout_height="56dp"
        android:backgroundTint="#4CAF50"
        android:text="保存"
        android:textColor="#FFFFFF"
        android:textSize="24sp"
        android:layout_marginTop="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tts_copyright_notice" />

</androidx.constraintlayout.widget.ConstraintLayout>
