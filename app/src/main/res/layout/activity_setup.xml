<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:padding="48dp">

    <!-- タイトル -->
    <TextView
        android:id="@+id/title_text_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="初回設定"
        android:textColor="#FFFFFF"
        android:textSize="48sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/postal_code_label"
        app:layout_constraintVertical_chainStyle="spread_inside" />

    <!-- 郵便番号ラベル -->
    <TextView
        android:id="@+id/postal_code_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="郵便番号（7桁）"
        android:textColor="#FFFFFF"
        android:textSize="32sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/title_text_view"
        app:layout_constraintBottom_toTopOf="@id/postal_code_edit_text" />

    <!-- 郵便番号入力 -->
    <EditText
        android:id="@+id/postal_code_edit_text"
        android:layout_width="400dp"
        android:layout_height="80dp"
        android:background="#333333"
        android:gravity="center"
        android:hint="例: 1000001"
        android:inputType="number"
        android:maxLength="7"
        android:textColor="#FFFFFF"
        android:textColorHint="#888888"
        android:textSize="32sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/postal_code_label"
        app:layout_constraintBottom_toTopOf="@id/news_interval_label" />

    <!-- ニュース読み上げ間隔ラベル -->
    <TextView
        android:id="@+id/news_interval_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="ニュース読み上げ間隔"
        android:textColor="#FFFFFF"
        android:textSize="32sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/postal_code_edit_text"
        app:layout_constraintBottom_toTopOf="@id/news_interval_text_view" />

    <!-- ニュース読み上げ間隔表示 -->
    <TextView
        android:id="@+id/news_interval_text_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="30 分"
        android:textColor="#FFFFFF"
        android:textSize="36sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/news_interval_label"
        app:layout_constraintBottom_toTopOf="@id/news_interval_seek_bar" />

    <!-- ニュース読み上げ間隔スライダー -->
    <SeekBar
        android:id="@+id/news_interval_seek_bar"
        android:layout_width="600dp"
        android:layout_height="wrap_content"
        android:max="60"
        android:min="1"
        android:progress="30"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/news_interval_text_view"
        app:layout_constraintBottom_toTopOf="@id/rss_preset_label" />

    <!-- RSS URLプリセットラベル -->
    <TextView
        android:id="@+id/rss_preset_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="RSS配信元"
        android:textColor="#FFFFFF"
        android:textSize="32sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/news_interval_seek_bar"
        app:layout_constraintBottom_toTopOf="@id/rss_preset_spinner" />

    <!-- RSSプリセット選択 -->
    <Spinner
        android:id="@+id/rss_preset_spinner"
        android:layout_width="600dp"
        android:layout_height="60dp"
        android:background="#333333"
        android:padding="12dp"
        android:popupBackground="#333333"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/rss_preset_label"
        app:layout_constraintBottom_toTopOf="@id/rss_custom_url_edit_text" />

    <!-- カスタムURL入力 -->
    <EditText
        android:id="@+id/rss_custom_url_edit_text"
        android:layout_width="600dp"
        android:layout_height="60dp"
        android:background="#333333"
        android:gravity="center_vertical"
        android:hint="カスタムURL入力"
        android:inputType="textUri"
        android:padding="12dp"
        android:textColor="#FFFFFF"
        android:textColorHint="#888888"
        android:textSize="24sp"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/rss_preset_spinner"
        app:layout_constraintBottom_toTopOf="@id/enable_tts_checkbox" />

    <!-- TTS有効化チェックボックス -->
    <CheckBox
        android:id="@+id/enable_tts_checkbox"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="読み上げ機能を有効にする"
        android:textColor="#FFFFFF"
        android:textSize="28sp"
        android:checked="false"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/rss_custom_url_edit_text"
        app:layout_constraintBottom_toTopOf="@id/tts_copyright_notice" />

    <!-- 著作権注意 -->
    <TextView
        android:id="@+id/tts_copyright_notice"
        android:layout_width="600dp"
        android:layout_height="wrap_content"
        android:text="※著作権は各コンテンツ提供者に帰属します"
        android:textColor="#FFCC00"
        android:textSize="20sp"
        android:gravity="center"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/enable_tts_checkbox"
        app:layout_constraintBottom_toTopOf="@id/save_button" />

    <!-- 保存ボタン -->
    <Button
        android:id="@+id/save_button"
        android:layout_width="300dp"
        android:layout_height="80dp"
        android:backgroundTint="#4CAF50"
        android:text="保存"
        android:textColor="#FFFFFF"
        android:textSize="32sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/news_interval_seek_bar"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
