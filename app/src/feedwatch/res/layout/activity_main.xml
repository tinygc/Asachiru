<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".presentation.main.MainActivity">

    <!-- パステルカラーのグラデーション背景 -->
    <com.tinygc.asachiru.presentation.main.views.BackgroundGradientView
        android:id="@+id/background_gradient_view"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- ドットパターンオーバーレイ -->
    <com.tinygc.asachiru.presentation.main.views.DotPatternView
        android:id="@+id/dot_pattern_view"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- パーティクルアニメーション -->
    <com.tinygc.asachiru.presentation.main.views.ParticleView
        android:id="@+id/particle_view"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- ビジュアライザー（背景として全画面） -->
    <com.tinygc.asachiru.presentation.main.views.VisualizerView
        android:id="@+id/visualizer_view"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- デバッグ情報（DEBUG BUILD時のみ表示） -->
    <TextView
        android:id="@+id/debug_info_view"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="16dp"
        android:background="#80000000"
        android:padding="8dp"
        android:textColor="#FFFFFF"
        android:textSize="12sp"
        android:visibility="gone"
        android:fontFamily="monospace"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="[DEBUG] TTS: ON"
        tools:visibility="visible" />

    <!-- 時計（上部） -->
    <com.tinygc.asachiru.presentation.main.views.ClockView
        android:id="@+id/clock_view"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="20dp"
        app:layout_constraintHeight_percent="0.13"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/weather_view"
        app:layout_constraintVertical_chainStyle="packed"
        app:layout_constraintVertical_bias="0.5" />

    <!-- 天気（中央） -->
    <com.tinygc.asachiru.presentation.main.views.WeatherView
        android:id="@+id/weather_view"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="20dp"
        app:layout_constraintHeight_percent="0.22"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/clock_view"
        app:layout_constraintBottom_toTopOf="@id/music_track_view" />

    <!-- 音楽トラック名（天気の下に控えめ表示） -->
    <com.tinygc.asachiru.presentation.main.views.MusicTrackView
        android:id="@+id/music_track_view"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="20dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/weather_view"
        app:layout_constraintBottom_toTopOf="@id/news_view" />

    <!-- ニュース（下部） -->
    <com.tinygc.asachiru.presentation.main.views.NewsView
        android:id="@+id/news_view"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        app:layout_constraintHeight_percent="0.26"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/music_track_view"
        app:layout_constraintBottom_toTopOf="@id/settings_button" />

    <!-- 上三角（前の記事） -->
    <ImageView
        android:id="@+id/arrow_up"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:src="@drawable/ic_triangle_up"
        android:scaleType="center"
        android:scaleY="1.2"
        android:alpha="0.5"
        android:layout_marginBottom="-16dp"
        app:layout_constraintBottom_toTopOf="@id/news_view"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- 下三角（次の記事） -->
    <ImageView
        android:id="@+id/arrow_down"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:src="@drawable/ic_triangle_down"
        android:scaleType="center"
        android:scaleY="1.2"
        android:alpha="0.5"
        android:layout_marginTop="-16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/news_view" />

    <!-- 新着待ちアナウンス -->
    <TextView
        android:id="@+id/waiting_announcement_view"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="📰 新着記事があれば、またお届けします…"
        android:textColor="#AAFFFFFF"
        android:textSize="11sp"
        android:letterSpacing="0.02"
        android:textAlignment="center"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="8dp"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/arrow_down"
        tools:visibility="visible" />

    <!-- キー操作ヒント（非表示・後方互換性） -->
    <TextView
        android:id="@+id/key_hint_view"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        tools:visibility="gone" />

    <!-- 「次へ →」ラベル（非表示・後方互換性） -->
    <TextView
        android:id="@+id/progress_next_label"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        tools:visibility="gone" />

    <!-- 広告ビューコンテナ（画面下部） -->
    <FrameLayout
        android:id="@+id/ad_view_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:visibility="gone"
        android:elevation="10dp"
        app:layout_constraintBottom_toTopOf="@id/settings_button"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        tools:visibility="visible" />

    <!-- 広告カウントダウン表示 -->
    <TextView
        android:id="@+id/ad_countdown_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:background="@drawable/rounded_button_bg"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:text="広告終了まで 10秒"
        android:textColor="#FFFFFF"
        android:textSize="12sp"
        android:letterSpacing="0.01"
        android:elevation="12dp"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/ad_view_container"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        tools:visibility="visible" />

    <!-- 設定ボタン（画面下部中央） -->
    <Button
        android:id="@+id/settings_button"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:minHeight="48dp"
        android:layout_marginBottom="16dp"
        android:text="設定"
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        android:letterSpacing="0.05"
        android:background="@drawable/rounded_button_bg"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:elevation="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
